# Copy to .env.development and .env.production, then fill in.
# Never commit the real files (.gitignore covers .env.*).
#
# Vite picks the file automatically by mode — you do NOT pass anything:
#   npm run dev    -> .env.development   (dev Directus)
#   npm run build  -> .env.production    (prod Directus)
#
# Precedence, lowest to highest:
#   .env  <  .env.[mode]  <  .env.local  <  .env.[mode].local
# A plain `.env` is optional; the two mode files above are what matter.
#
# ALL VITE_* VALUES ARE INLINED INTO THE BUILT BUNDLE and are publicly
# readable in dist/assets/*.js. Never put a real secret in a production file.

# Directus instance this build talks to.
#   dev  -> https://dev-admin.kudafellas.cloud
#   prod -> https://admin.kudafellas.cloud
VITE_DIRECTUS_URL=https://admin.kudafellas.cloud

# Static Directus access token (Directus admin -> User Directory -> user -> Token).
# Currently DEAD CONFIG: the app builds a `tokenClient` from it, but
# `getTokenClient()` is never called, so every request uses the authenticated
# login client instead. Leave EMPTY in production so a long-lived token is not
# published in the bundle. Only useful for local debugging.
VITE_DIRECTUS_TOKEN=

# Shared secret sent as the `x-internal-token` header to the order-api's
# /order-api/parse-order endpoint (WhatsApp intake parser). Without it,
# parsing fails with "Parse API error 401: Unauthorized".
# Get the current value from whoever runs order-api/n8n.
# WARNING: exposed in the bundle if set for a production build.
VITE_INTERNAL_TOKEN=
