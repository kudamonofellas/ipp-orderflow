{
  "name": "push-notify",
  "version": "1.0.0",
  "description": "FCM push on order stage change for Kudafellas OrderFlow",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "directus:extension": {
    "type": "hook",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^10.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build --watch",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "10.3.4"
  }
}
